NGA_REMINDER__API_TOKEN=replace-with-a-long-random-token
NGA_REMINDER__ADMIN_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -base64 32
NGA_REMINDER__CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
NGA_REMINDER__DATABASE_BACKEND=postgres
NGA_REMINDER__DATABASE_URL=postgres://nga_reminder:nga_reminder@127.0.0.1:5432/nga_reminder
# Used when DATABASE_BACKEND=sqlite.
NGA_REMINDER__SQLITE_PATH=./data/nga-reminder.db
NGA_REMINDER__BIND_ADDR=127.0.0.1:8080
NGA_REMINDER__NGA_USER_AGENT=Mozilla/5.0 (compatible; NGA-Reminder/0.1)
NGA_REMINDER__SCHEDULER__DEFAULT_INTERVAL_SECONDS=60
# Local time used to evaluate watch schedules.
NGA_REMINDER__SCHEDULER__TIMEZONE_OFFSET=+08:00
NGA_REMINDER__PERSISTENCE__STORE_RAW_PAYLOAD=false
NGA_REMINDER__OBSERVABILITY__LOG_FILTER=info,sqlx=warn
NGA_REMINDER__OBSERVABILITY__LOG_JSON=false
