# NGA Reminder 服务配置示例。
#
# 将本文件复制为 .env，并替换所有标记为必填的占位值。
# SQLite 单机生产部署使用：
#   docker compose -f compose.production.yml up -d
# 生产 Compose 模板会固定使用 DATABASE_BACKEND=sqlite，并将数据库和资源保存在容器内的 /data 下。
# 本文件同时保留开发环境 compose.yml 使用的 PostgreSQL 配置说明。

# 必填：受保护 /api/v1/* 接口使用的 Bearer token，建议使用足够长的随机字符串。
NGA_REMINDER__API_TOKEN=replace-with-a-long-random-token

# 必填：/admin 管理台的管理员密码。
NGA_REMINDER__ADMIN_PASSWORD=replace-with-a-long-random-password

# 必填：用于加密 NGA Cookie 和通知渠道密钥的 base64 编码 32 字节 AES-256-GCM 密钥。
# 生成命令：openssl rand -base64 32
# 请永久保存此密钥；密钥丢失后，已有加密凭据将无法恢复。
NGA_REMINDER__CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# 数据库后端：postgres 或 sqlite。
# 开发环境 compose.yml 通常使用 postgres；compose.production.yml 始终固定使用 sqlite。
NGA_REMINDER__DATABASE_BACKEND=postgres

# PostgreSQL 连接字符串，仅在 DATABASE_BACKEND=postgres 时使用。
NGA_REMINDER__DATABASE_URL=postgres://nga_reminder:nga_reminder@127.0.0.1:5432/nga_reminder

# SQLite 数据库文件，仅在 DATABASE_BACKEND=sqlite 时使用。
# 使用 compose.production.yml 时，应确保路径位于持久化的 /data 卷内。
NGA_REMINDER__SQLITE_PATH=./data/nga-reminder.db

# 数据库最大连接数。单进程 SQLite 部署建议设置为 1。
NGA_REMINDER__DATABASE_MAX_CONNECTIONS=10

# HTTP 监听地址。生产容器的 compose.production.yml 使用 0.0.0.0:12888。
NGA_REMINDER__BIND_ADDR=127.0.0.1:8080

# 服务启动时自动执行 SQLx migration，正常部署建议保持为 true。
NGA_REMINDER__RUN_MIGRATIONS=true

# 发送给 NGA 的 User-Agent，建议保留服务名称，便于运维排查。
NGA_REMINDER__NGA_USER_AGENT="Mozilla/5.0 (compatible; NGA-Reminder/0.1)"

# 可选：Compose 用于发布、升级或回滚的 Docker 镜像标签。
# 示例：NGA_REMINDER_IMAGE=ghcr.io/lostmoonkin/ngareminder:v0.1.0
# NGA_REMINDER_IMAGE=ghcr.io/lostmoonkin/ngareminder:latest

# 未配置匹配 schedule 规则时使用的默认抓取间隔，单位为秒。
# 有效范围：30～86400 秒。
NGA_REMINDER__SCHEDULER__DEFAULT_INTERVAL_SECONDS=60

# 计算监控 schedule 时使用的时区，格式为 +HH:MM、-HH:MM 或 Z。
# 中国标准时间为 +08:00。
NGA_REMINDER__SCHEDULER__TIMEZONE_OFFSET=+08:00

# 除标准化字段外，是否保存 NGA 帖子的完整原始 JSON。
# 通常建议保持 false，以减少敏感数据和存储占用；仅在解析诊断需要时开启。
NGA_REMINDER__PERSISTENCE__STORE_RAW_PAYLOAD=false

# 是否将正文图片和附件下载到本地。关闭时只保存资源元数据和远程 URL。
NGA_REMINDER__ASSETS__DOWNLOAD_ENABLED=false

# 本地资源目录，必须与所选数据库一起备份。
NGA_REMINDER__ASSETS__STORAGE_PATH=./data/assets

# 单个下载资源允许的最大字节数，默认值为 10 MiB。
NGA_REMINDER__ASSETS__MAX_DOWNLOAD_BYTES=10485760

# tracing 日志过滤器，默认配置会压低 SQLx 的详细日志。
NGA_REMINDER__OBSERVABILITY__LOG_FILTER=info,sqlx=warn

# 是否输出 JSON 结构化日志。接入 Loki、ELK 等日志系统时建议设置为 true。
NGA_REMINDER__OBSERVABILITY__LOG_JSON=false
